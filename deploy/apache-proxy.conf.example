# Fragmento para el VirtualHost HTTPS del subdominio Kalu gestionado por Virtualmin.
# Sustituir el dominio y conservar los bloques SSL existentes de Virtualmin.
ServerName kalu.example.com
ProxyPreserveHost On
ProxyPass / http://127.0.0.1:3000/
ProxyPassReverse / http://127.0.0.1:3000/
RequestHeader set X-Forwarded-Proto "https"
